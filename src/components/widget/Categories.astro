---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

const parentCategories = await getCategoryList();
type CountableNode = { children?: CountableNode[] };
const countNodes = (nodes: CountableNode[]): number =>
	nodes.reduce((total, node) => total + 1 + countNodes(node.children ?? []), 0);
const visibleNodeCount = countNodes(parentCategories);

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const isCollapsed = visibleNodeCount >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.categories)} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    <category-tree>
        {parentCategories.map((parentCategory, parentIndex) => (
            <div class="category-node" data-level="parent" data-parent={parentCategory.value} data-node-label={parentCategory.name.trim()}>
                <div class="category-row flex items-center gap-1">
                    <div class="min-w-0 flex-1">
                        <ButtonLink
                            url={parentCategory.url}
                            badge={String(parentCategory.count)}
                            label={`查看“${parentCategory.name.trim()}”中的全部文章`}
                        >
                            {parentCategory.name.trim()}
                        </ButtonLink>
                    </div>
                    <button
                        type="button"
                        class="category-toggle btn-plain flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                        aria-expanded="true"
                        aria-controls={`parent-category-children-${parentIndex}`}
                        aria-label={`收起 ${parentCategory.name.trim()} 的子分类`}
                    >
                        <Icon name="material-symbols:chevron-right-rounded" class="category-chevron rotate-90 text-xl transition-transform" />
                    </button>
                </div>
                <div id={`parent-category-children-${parentIndex}`} class="category-children ml-5 border-l border-[var(--line-divider)] pl-2">
                    {parentCategory.children.map((category, categoryIndex) => category.children.length > 0 ? (
                        <div class="category-node" data-level="category" data-parent={parentCategory.value} data-category={category.name.trim()} data-node-label={category.name.trim()}>
                            <div class="category-row flex items-center gap-1">
                                <div class="min-w-0 flex-1">
                                    <ButtonLink
                                        url={category.url}
                                        badge={String(category.count)}
                                        label={`查看“${parentCategory.name.trim()} / ${category.name.trim()}”分类中的全部文章`}
                                    >
                                        {category.name.trim()}
                                    </ButtonLink>
                                </div>
                                <button
                                    type="button"
                                    class="category-toggle btn-plain flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                                    aria-expanded="false"
                                    aria-controls={`category-children-${parentIndex}-${categoryIndex}`}
                                    aria-label={`展开 ${category.name.trim()} 的子分类`}
                                >
                                    <Icon name="material-symbols:chevron-right-rounded" class="category-chevron text-xl transition-transform" />
                                </button>
                            </div>
                            <div id={`category-children-${parentIndex}-${categoryIndex}`} class="category-children ml-5 border-l border-[var(--line-divider)] pl-2" hidden>
                                {category.children.map((subcategory, subcategoryIndex) => subcategory.children.length > 0 ? (
                                    <div class="category-node" data-level="subcategory" data-parent={parentCategory.value} data-category={category.name.trim()} data-subcategory={subcategory.name.trim()} data-node-label={subcategory.name.trim()}>
                                        <div class="category-row flex items-center gap-1">
                                            <div class="min-w-0 flex-1">
                                                <ButtonLink
                                                    url={subcategory.url}
                                                    badge={String(subcategory.count)}
                                                    label={`查看“${parentCategory.name.trim()} / ${category.name.trim()} / ${subcategory.name.trim()}”分类中的全部文章`}
                                                >
                                                    {subcategory.name.trim()}
                                                </ButtonLink>
                                            </div>
                                            <button
                                                type="button"
                                                class="category-toggle btn-plain flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                                                aria-expanded="false"
                                                aria-controls={`subcategory-children-${parentIndex}-${categoryIndex}-${subcategoryIndex}`}
                                                aria-label={`展开 ${subcategory.name.trim()} 的子分类`}
                                            >
                                                <Icon name="material-symbols:chevron-right-rounded" class="category-chevron text-xl transition-transform" />
                                            </button>
                                        </div>
                                        <div id={`subcategory-children-${parentIndex}-${categoryIndex}-${subcategoryIndex}`} class="category-children ml-5 border-l border-[var(--line-divider)] pl-2" hidden>
                                            {subcategory.children.map((series, seriesIndex) => series.children.length > 0 ? (
                                                <div class="category-node" data-level="series" data-parent={parentCategory.value} data-category={category.name.trim()} data-subcategory={subcategory.name.trim()} data-series={series.name.trim()} data-node-label={series.name.trim()}>
                                                    <div class="category-row flex items-center gap-1">
                                                        <div class="min-w-0 flex-1">
                                                            <ButtonLink
                                                                url={series.url}
                                                                badge={String(series.count)}
                                                                label={`查看“${series.name.trim()}”系列中的全部文章`}
                                                            >
                                                                {series.name.trim()}
                                                            </ButtonLink>
                                                        </div>
                                                        <button
                                                            type="button"
                                                            class="category-toggle btn-plain flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"
                                                            aria-expanded="false"
                                                            aria-controls={`series-children-${parentIndex}-${categoryIndex}-${subcategoryIndex}-${seriesIndex}`}
                                                            aria-label={`展开 ${series.name.trim()} 的章节`}
                                                        >
                                                            <Icon name="material-symbols:chevron-right-rounded" class="category-chevron text-xl transition-transform" />
                                                        </button>
                                                    </div>
                                                    <div id={`series-children-${parentIndex}-${categoryIndex}-${subcategoryIndex}-${seriesIndex}`} class="category-children ml-5 border-l border-[var(--line-divider)] pl-2" hidden>
                                                        {series.children.map((section) => (
                                                            <div class="category-node" data-level="section" data-parent={parentCategory.value} data-category={category.name.trim()} data-subcategory={subcategory.name.trim()} data-series={series.name.trim()} data-section={section.name.trim()} data-node-label={section.name.trim()}>
                                                                <ButtonLink
                                                                    url={section.url}
                                                                    badge={String(section.count)}
                                                                    label={`查看“${series.name.trim()} / ${section.name.trim()}”中的全部文章`}
                                                                >
                                                                    {section.name.trim()}
                                                                </ButtonLink>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            ) : (
                                                <div class="category-node" data-level="series" data-parent={parentCategory.value} data-category={category.name.trim()} data-subcategory={subcategory.name.trim()} data-series={series.name.trim()} data-node-label={series.name.trim()}>
                                                    <ButtonLink url={series.url} badge={String(series.count)} label={`查看“${series.name.trim()}”系列中的全部文章`}>
                                                        {series.name.trim()}
                                                    </ButtonLink>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                ) : (
                                    <div class="category-node" data-level="subcategory" data-parent={parentCategory.value} data-category={category.name.trim()} data-subcategory={subcategory.name.trim()} data-node-label={subcategory.name.trim()}>
                                        <ButtonLink
                                            url={subcategory.url}
                                            badge={String(subcategory.count)}
                                            label={`查看“${parentCategory.name.trim()} / ${category.name.trim()} / ${subcategory.name.trim()}”分类中的全部文章`}
                                        >
                                            {subcategory.name.trim()}
                                        </ButtonLink>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <ButtonLink
                            url={category.url}
                            badge={String(category.count)}
                            label={`查看“${parentCategory.name.trim()} / ${category.name.trim()}”分类中的全部文章`}
                        >
                            {category.name.trim()}
                        </ButtonLink>
                    ))}
                </div>
            </div>
        ))}
    </category-tree>
</WidgetLayout>

<script>
    class CategoryTree extends HTMLElement {
        connectedCallback() {
            if (this.dataset.initialized === "true") return;
            this.dataset.initialized = "true";

            const setExpanded = (button: HTMLButtonElement, expanded: boolean) => {
                const targetId = button.getAttribute("aria-controls");
                const children = targetId ? this.querySelector<HTMLElement>(`#${targetId}`) : null;
                if (!children) return;

                button.setAttribute("aria-expanded", String(expanded));
                button.setAttribute(
                    "aria-label",
                    `${expanded ? "收起" : "展开"} ${button.closest<HTMLElement>(".category-node")?.dataset.nodeLabel ?? ""} 的子分类`,
                );
                children.hidden = !expanded;
                button.querySelector(".category-chevron")?.classList.toggle("rotate-90", expanded);
            };

            this.querySelectorAll<HTMLButtonElement>(".category-toggle").forEach((button) => {
                button.addEventListener("click", () => {
                    setExpanded(button, button.getAttribute("aria-expanded") !== "true");
                });
            });

            const params = new URLSearchParams(window.location.search);
            const activePath = {
                parent: params.get("parent"),
                category: params.get("category"),
                subcategory: params.get("subcategory"),
                series: params.get("series"),
                section: params.get("section"),
            };
            const levels = ["section", "series", "subcategory", "category", "parent"] as const;
            const activeLevel = levels.find((level) => activePath[level] !== null);
            if (!activeLevel) return;

            const activeNode = Array.from(this.querySelectorAll<HTMLElement>(`[data-level="${activeLevel}"]`)).find(
                (node) => levels.every((level) => activePath[level] === null || node.dataset[level] === activePath[level]),
            );
            let node = activeNode?.closest<HTMLElement>(".category-node") ?? null;
            while (node) {
                const button = node.querySelector<HTMLButtonElement>(":scope > .category-row > .category-toggle");
                if (button) setExpanded(button, true);
                node = node.parentElement?.closest<HTMLElement>(".category-node") ?? null;
            }
        }
    }

    if (!customElements.get("category-tree")) {
        customElements.define("category-tree", CategoryTree);
    }
</script>
